# vision-work — GUI 判分线（靶场 + 全盲驱动 + 评分器）
#
# 规则：批次证据只入库 sol/sandbox/t_trap*.json；运行产物、本机 UI 截图、
#       与判分线无关的历史材料一律不入库。本文件只声明"哪些不提交"，
#       不改动、不删除磁盘上的任何文件。

# ---------- 运行产物（每次跑批都会重写/覆盖） ----------
*-events.jsonl
*-state.json
*-out.txt
*.err
*.log
*.jsonl

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo

# ---------- 本机 UI 截图：一律不入库（沿用 dsh-vision-kit 的规则） ----------
*.png

# ---------- 一次性调试脚本 / 填充曲线目录 ----------
sol/sandbox/_*.py
sol/sandbox/_fill_curve/
sol/sandbox/_fill_curve2/
_fill_curve*/

# ---------- sol/sandbox：只保留批次证据与探针 ----------
# 先忽略 sandbox 下的全部 json，再把批次证据显式放行；
# negation 在最后，保证 t_trap*.json 不会被误伤。
sol/sandbox/*.json
!sol/sandbox/t_trap*.json
# 放行之后再把批次的 state 重新排除（最后命中的规则生效）
sol/sandbox/t_trap*-state.json
sol/sandbox/*.txt
sol/sandbox/*.out
sol/sandbox/*.box
sol/sandbox/audit_runs.py
sol/sandbox/find_run.py
sol/sandbox/patch_w6.py
sol/sandbox/score_read.py
sol/sandbox/spider_sandbox.py
sol/sandbox/spider_table.py

# ---------- 与判分线无关的历史材料（保留在磁盘，不入库） ----------
